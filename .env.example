# Copy to .env and fill in. Never commit .env.

# --- Required ---
POSTGRES_PASSWORD=
# At least 32 random characters, e.g.  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# --- Optional (defaults shown) ---
POSTGRES_USER=txt2md
POSTGRES_DB=txt2md
ENVIRONMENT=development          # "production" disables /docs and /redoc
MAX_FILE_SIZE_MB=10
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Used when running the backend without Docker (see backend/.env.example) ---
# DATABASE_URL=postgresql+psycopg://txt2md:<password>@localhost:5432/txt2md
# UPLOAD_DIR=./data/uploads
# OUTPUT_DIR=./data/outputs
